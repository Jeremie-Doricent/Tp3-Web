@{
}
@model _6325048_Jérémie_Doricent_TP2.Models.Enfant

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Confirmer la suppression</h2>
    <p>Êtes-vous sûr de vouloir supprimer ce personnage ?</p>

    <div class="card" style="max-width: 400px;">
        <img src="~/images/@(Model.Id).png" class="card-img-top" alt="@Model.Nom" />
        <div class="card-body">
            <h5 class="card-title">@Model.Nom</h5>
            <p>@Model.Id</p>
        </div>
    </div>

    <form asp-action="Delete" asp-controller="GestionEnfant" method="post" class="mt-3">
        <input type="hidden" name="Id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a href="/Enfant/Recherche" class="btn btn-secondary ms-2">Annuler</a>
    </form>
</div>