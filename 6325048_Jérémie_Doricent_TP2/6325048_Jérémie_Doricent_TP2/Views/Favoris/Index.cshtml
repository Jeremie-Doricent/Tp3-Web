@model List<_6325048_Jérémie_Doricent_TP2.Models.Enfant>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Mes Favoris (@Model.Count éléments)</h2>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enfant in Model)
            {
                <tr>
                    <td>
                        <img src="~/images/@(enfant.Id).png"
                             height="50" alt="@enfant.Nom" />
                    </td>
                    <td>@enfant.Nom</td>
                    <td>
                        <form asp-action="SupprimerUnEnfant"
                              asp-controller="Favoris"
                              method="post">
                            <input type="hidden" name="id" value="@enfant.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>